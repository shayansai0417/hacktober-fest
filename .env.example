# Application environment
APP_ENV=development
APP_SECRET_KEY=
DEMO_MODE=true
DATABASE_URL=sqlite:///./papergrade.db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20
GEMMA_TIMEOUT_SECONDS=300
GEMMA_IMAGE_BATCH_SIZE=12

# Google AI Studio API key for LIVE GEMMA MODE. Never commit your .env file.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Report branding
TEACHER_NAME=Maya Patel
INSTITUTION=Northstar Learning Centre
TEACHER_EMAIL=maya@example.edu

# Local example account; never enabled automatically in production deployments.
DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_EMAIL=demo@papergrade.ai
DEMO_LOGIN_PASSWORD=DemoPaperGrade2026!

# Set REQUIRE_EMAIL_VERIFICATION=true in production and configure SMTP below.
REQUIRE_EMAIL_VERIFICATION=false
PUBLIC_APP_URL=http://localhost:8501
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
